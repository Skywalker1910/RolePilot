# Root-owned /etc/rolepilot/rolepilot.env, mode 0640, group rolepilot.
# Plain KEY=value only; no shell expansion. Keep runtime credentials on the server.
ROLEPILOT_AUTH_REQUIRED=1
ROLEPILOT_COOKIE_SECURE=1
ROLEPILOT_PUBLIC_ORIGIN=https://career.adityamore.dev
ROLEPILOT_ALLOWED_HOSTS=career.adityamore.dev
ROLEPILOT_DATA_DIR=/var/lib/rolepilot
ROLEPILOT_LIBRARY_ROOT=/var/lib/rolepilot/library
ROLEPILOT_DOCUMENT_STORAGE=/var/lib/rolepilot/documents
ROLEPILOT_BACKUP_DIR=/var/backups/rolepilot/database
