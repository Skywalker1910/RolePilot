[Unit]
Description=Create a consistent RolePilot database backup
After=rolepilot.service

[Service]
Type=oneshot
User=rolepilot
Group=rolepilot
WorkingDirectory=/opt/rolepilot/current
EnvironmentFile=/etc/rolepilot/rolepilot.env
Environment=PYTHONPATH=/opt/rolepilot/current/backend
UMask=0077
ExecStart=/bin/bash /opt/rolepilot/current/deploy/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/rolepilot /var/lib/rolepilot
StandardOutput=journal
StandardError=journal
